<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/home_saved_card_width"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_recipe"
        android:layout_width="@dimen/home_saved_image_size"
        android:layout_height="@dimen/home_saved_image_size"
        android:scaleType="centerCrop"
        android:background="@color/white"
        android:elevation="12dp"
        android:outlineAmbientShadowColor="@color/gray_4"
        android:outlineSpotShadowColor="@color/gray_4"
        android:translationZ="11dp"
        android:src="@drawable/ic_default_image"
        app:strokeWidth="1dp"
        app:strokeColor="@color/gray_4"
        android:contentDescription="@string/home_recipe_image_description"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_saved"
        android:layout_width="@dimen/home_saved_card_width"
        android:layout_height="@dimen/home_saved_card_height"
        android:layout_marginStart="2dp"
        android:layout_marginTop="@dimen/home_saved_image_overlap"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="10dp"
        android:outlineAmbientShadowColor="@color/gray_4"
        android:outlineSpotShadowColor="@color/gray_4"
        app:cardBackgroundColor="@color/primary_20"
        app:cardCornerRadius="@dimen/corner_radius"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/home_saved_content_top_padding"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <TextView
                android:id="@+id/tv_title"
                tools:text="Classic Greek Salad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/gray_1"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/home_ready_time_label"
                android:textColor="@color/gray_3"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/gray_1"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_time_label" />

            <ImageView
                android:id="@+id/iv_save"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_saved_filled"
                android:contentDescription="@string/home_saved_recipe_content_description"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
