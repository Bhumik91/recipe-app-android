<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chip_item"
    tools:text="Indian"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/home_chip_height"
    android:checkable="true"
    android:fontFamily="@font/poppins_regular"
    android:textColor="@color/chip_text_color_selector"
    android:textSize="14sp"
    android:elevation="0dp"
    app:checkedIconVisible="false"
    app:chipBackgroundColor="@color/chip_background_selector"
    app:chipCornerRadius="10dp"
    app:chipEndPadding="@dimen/spacing_md"
    app:chipMinHeight="@dimen/home_chip_height"
    app:chipStartPadding="@dimen/spacing_md"
    app:chipStrokeColor="@color/chip_stroke_selector"
    app:chipStrokeWidth="2dp"
    app:chipSurfaceColor="@color/white"
    app:elevation="0dp"
    app:ensureMinTouchTargetSize="false"
    app:rippleColor="@android:color/transparent" />
